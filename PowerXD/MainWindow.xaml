<Window x:Class="PowerXD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerXD"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20">
        <Border x:Name="Card"
                CornerRadius="20"
                Background="{StaticResource PanelGradientBrush}"
                BorderBrush="{StaticResource BorderStrokeBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" Direction="270" />
            </Border.Effect>

            <Grid Margin="18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{StaticResource AccentGradientBrush}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White"
                                      Data="M13,3 h-2 v10 h2 Z M17.83,5.17 l-1.42,1.42 C17.99,7.86 19,9.81 19,12 c0,3.87 -3.13,7 -7,7 s-7,-3.13 -7,-7 c0,-2.19 1.01,-4.14 2.58,-5.42 L6.17,5.17 C4.23,6.82 3,9.26 3,12 c0,4.97 4.03,9 9,9 s9,-4.03 9,-9 c0,-2.74 -1.23,-5.18 -3.17,-6.83 Z" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PowerXD" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SubtitleText" Text="Select power mode" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Modes -->
                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="260">
                    <ItemsControl x:Name="ModesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ModeItemStyle}"
                                        Margin="0,0,0,4"
                                        Click="Mode_Click">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Settings -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="RunAtStartupText" Text="Run at startup" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="LanguageText" Text="Language" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoStartToggle" Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <RadioButton x:Name="LangRu" Style="{StaticResource LangChipStyle}"
                                         Content="RU" GroupName="Lang" Margin="0,0,6,0" Checked="Lang_Checked" />
                            <RadioButton x:Name="LangEn" Style="{StaticResource LangChipStyle}"
                                         Content="EN" GroupName="Lang" Checked="Lang_Checked" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Button Grid.Row="3" Style="{StaticResource ExitButtonStyle}" Margin="0,14,0,0"
                        Click="Exit_Click">
                    <TextBlock x:Name="ExitText" Text="Exit" />
                </Button>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
