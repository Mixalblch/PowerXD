<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Colors ============ -->
    <Color x:Key="AccentColor">#FF7C6CFF</Color>
    <Color x:Key="Accent2Color">#FF4E8DFF</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F4F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA0B2" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF6B7180" />

    <SolidColorBrush x:Key="BorderStrokeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="CardActiveBrush" Color="#247C6CFF" />
    <SolidColorBrush x:Key="TrackOffBrush" Color="#FF3A3A4A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF5A5F" />

    <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7222230" Offset="0" />
        <GradientStop Color="#F9171721" Offset="1" />
    </LinearGradientBrush>

    <!-- ============ Mode item ============ -->
    <Style x:Key="ModeItemStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="12" Background="{TemplateBinding Background}" Padding="13,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse x:Name="Dot" Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{Binding ColorBrush}" />

                            <ContentPresenter Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center"
                                              TextElement.FontSize="14" />

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Ellipse x:Name="CheckCircle" Width="20" Height="20"
                                         Fill="{StaticResource AccentGradientBrush}" Visibility="Collapsed" />
                                <Path x:Name="Check" Width="10" Height="10" Stretch="Uniform"
                                      Data="M2,5.5 L4.5,8 L9,3"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardActiveBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="CheckCircle" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Toggle switch ============ -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="42" Height="24" CornerRadius="12"
                            Background="{StaticResource TrackOffBrush}">
                        <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Language chip ============ -->
    <Style x:Key="LangChipStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="9,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Exit button ============ -->
    <Style x:Key="ExitButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#14FF5A5F" />
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
